# Empty uses the dashboard's own HTTPS origin (and Vite's dev proxy) in legacy mode.
VITE_DASHBOARD_API_URL=
# Match the worker's LOOP_INTERVAL_MS.
VITE_EXPECTED_CYCLE_INTERVAL_MS=90000

# Build legacy and Auth0 dashboard images separately.
VITE_DASHBOARD_AUTH_MODE=legacy
# Phase 5 defaults remain legacy until staging is configured.
# VITE_DASHBOARD_AUTH_MODE=auth0
# BFF_PUBLIC_ORIGIN=https://dex-orchestrator.best
# BFF_API_ORIGIN=http://127.0.0.1:8787
# AUTH0_ISSUER=https://YOUR-STAGING-TENANT.auth0.com/
# AUTH0_AUDIENCE=https://api.tradekeel.example
# AUTH0_CLIENT_ID=YOUR_REGULAR_WEB_APP_CLIENT_ID
# AUTH0_CLIENT_SECRET_PATH=/opt/tradekeel-app/secrets/auth0_client_secret.txt
